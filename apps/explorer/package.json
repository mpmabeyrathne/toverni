{
  "name": "@toverni/explorer",
  "version": "0.1.0",
  "description": "Local-first application exploration and grounded Playwright test generation.",
  "private": false,
  "type": "module",
  "bin": {
    "toverni": "dist/index.js"
  },
  "files": [
    "dist/",
    "drizzle/",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build && node scripts/prepare-package-assets.mjs",
    "postpack": "node scripts/cleanup-package-assets.mjs",
    "package:smoke": "node scripts/package-smoke.mjs",
    "model:smoke": "tsx src/models/ollama-provider.smoke.ts",
    "benchmark": "tsx src/benchmark/run-benchmark.ts",
    "benchmark:competitive": "tsx src/benchmark/run-competitive-benchmark.ts",
    "benchmark:competitive:playwright": "powershell -ExecutionPolicy Bypass -File ../../scripts/run-playwright-agents-competitive.ps1",
    "benchmark:competitive:playwright:normalize": "tsx src/benchmark/normalize-playwright-agents-artifact.ts",
    "benchmark:competitive:hercules": "powershell -ExecutionPolicy Bypass -File ../../scripts/run-hercules-competitive.ps1",
    "benchmark:competitive:hercules:normalize": "tsx src/benchmark/normalize-hercules-artifact.ts",
    "generate": "tsx src/index.ts generate",
    "release:gate": "tsx src/release/run-public-beta-gate.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "playwright": "^1.63.0",
    "undici": "^8.10.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5",
    "dotenv": "^18.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "keywords": [
    "playwright",
    "testing",
    "e2e",
    "ollama",
    "test-generation"
  ],
  "license": "ISC"
}
